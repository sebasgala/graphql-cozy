# Puerto del servidor GraphQL (el gateway ya enruta /graphql aquí)
PORT_GRAPHQL=3006

# Servicio dueño de cada operación (si falta, BACKEND_URL; si tampoco, localhost:3001..3004)
USUARIOS_URL=http://localhost:3001
CATALOGO_URL=http://localhost:3002
DISPONIBILIDAD_URL=http://localhost:3003
RESERVAS_URL=http://localhost:3004
BACKEND_URL=

# Verificación del JWT de la UI (D3): solo clave pública. Los saltos de línea pueden ir como \n.
# Si falta, se pide a usuarios en /api/v1/interno/usuarios/clave-publica.
JWT_PUBLIC_KEY=
JWT_ISSUER=
JWT_AUDIENCE=
# Solo pruebas, cuando no hay par RSA (HS256, mínimo 32 caracteres)
JWT_SECRET=

# Plazo por llamada a un servicio (ms). Por defecto 8000, menor que el del gateway (10 s)
GRAPHQL_TIMEOUT_MS=8000

# Confiar en el proxy delante (el gateway) para leer X-Forwarded-For
TRUST_PROXY=1

# CORS (solo si el navegador llama a graphql directo)
CORS_ORIGIN=http://localhost:5173

